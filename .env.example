# --- Required ---
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars-long
POSTGRES_PASSWORD=change-me-to-a-strong-db-password

# --- Database & Redis ---
DATABASE_URL=postgresql+asyncpg://lead:${POSTGRES_PASSWORD}@postgres:5432/lead
REDIS_URL=redis://redis:6379/0

# --- Frontend ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Auth ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# --- Environment ---
ENVIRONMENT=development

# --- Provider Tokens (optional for development) ---
# GOOGLE_PLACES_API_KEY=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# TELEGRAM_BOT_TOKEN=
# EITAA_APP_TOKEN=
# RUBIKA_BOT_TOKEN=